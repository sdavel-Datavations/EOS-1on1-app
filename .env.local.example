# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.
# Set the same values in Vercel > Project > Settings > Environment Variables.

# ── Supabase (required) ──
# Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin key. Needed for local seeding, the dev-only auth endpoints (which return
# 404 in production), and the notification job — cron has no user session, so it
# cannot go through RLS. Never expose this to the browser: it bypasses every
# RLS policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Slack (optional; required to DM tasks and to close them by replying) ──
# Create an app at api.slack.com/apps > From scratch, then:
#   OAuth & Permissions > Bot Token Scopes: chat:write, im:write, im:history,
#     users:read, users:read.email
#   im:history is required to RECEIVE replies; without it Slack accepts the
#     message.im subscription but never delivers anything.
#   Install to Workspace, then copy the Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=xoxb-...
# Basic Information > App Credentials > Signing Secret. Every inbound Slack
# request is HMAC-verified against this; without it the webhooks reject
# everything, which is the correct failure direction.
SLACK_SIGNING_SECRET=

# ── Email (optional; Resend) ──
# resend.com > API Keys. The from address must be on a domain you've verified.
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=1on1@yourdomain.com

# Signs the "Mark done" links in emails, which carry their own authority because
# an inbox has no session. Must be 32+ chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it invalidates every link already sent.
ACTION_TOKEN_SECRET=

# Shared secret for the scheduled notification run. Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET` once it is set here.
# Without it, /api/notify accepts only signed-in callers.
CRON_SECRET=

# ── Public URL ──
# Only needed locally, or on a custom domain. On Vercel this falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel injects for you.
NEXT_PUBLIC_APP_URL=
