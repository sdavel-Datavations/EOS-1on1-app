# Copy to .env.local and fill in. Never commit .env.local — it is gitignored.

# ── Supabase (required) ──
# Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin key. Needed only for local seeding and the dev-only auth endpoints,
# which return 404 in production. Never expose this to the browser — it
# bypasses every RLS policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Transcript extraction (required for "Next Steps from Transcript") ──
# Server-side only. Transcript content is sent to the Anthropic API for
# extraction; the transcript itself is never stored by this app.
ANTHROPIC_API_KEY=sk-ant-...

# ── Commitment notifications (optional, used by scripts/notify_commitments.js) ──
SENDGRID_API_KEY=
NOTIFY_EMAIL_FROM=noreply@yourdomain.com
SLACK_WEBHOOK_URL=
NOTIFY_DAYS_BEFORE=1
